generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id        String    @id @default(uuid())
  name      String
  service   String
  message   String
  eventType EventType
  timestamp DateTime
  createdAt DateTime  @default(now())
}

enum EventType {
  log
  error
}
